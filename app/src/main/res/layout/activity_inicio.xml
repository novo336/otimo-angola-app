<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ÓTIMO ANGOLA" android:textSize="10sp" android:textColor="#A3FF12"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Olá, João Viegas 👋" android:textSize="20sp" android:textStyle="bold" android:textColor="#000000"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Luanda, Angola" android:textColor="#757575" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:weightSum="3">
        <LinearLayout android:id="@+id/cardMudancas" android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_red_rounded" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚚" android:textSize="28sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mudanças" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="6dp"/></LinearLayout>
        <LinearLayout android:id="@+id/cardMercadorias" android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_gray_rounded" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="28sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mercadorias" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="6dp"/></LinearLayout>
        <LinearLayout android:id="@+id/cardExpressas" android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_gray_rounded" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:textSize="28sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entregas" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="6dp"/></LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/btnVerHorarios" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:background="@drawable/bg_red_rounded" android:text="Ver Camiões Disponíveis →" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF"/>
    <TextView android:id="@+id/btnMotorista" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_white_rounded" android:text="Sou Motorista - Cadastrar" android:gravity="center" android:textStyle="bold"/>
</LinearLayout>
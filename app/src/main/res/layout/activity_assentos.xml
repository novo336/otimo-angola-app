<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView android:id="@+id/btnVoltarAssentos"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="← Voltar" android:textSize="16sp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Escolhe o teu assento"
        android:textSize="22sp" android:textStyle="bold"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Frente do autocarro ↑" android:layout_marginTop="20dp"
        android:textColor="#757575" android:layout_gravity="center"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginTop="16dp">
        <TextView android:id="@+id/assento1" android:layout_width="60dp" android:layout_height="60dp"
            android:text="1" android:gravity="center" android:background="@drawable/bg_gray_rounded" android:layout_margin="8dp"/>
        <TextView android:id="@+id/assento2" android:layout_width="60dp" android:layout_height="60dp"
            android:text="2" android:gravity="center" android:background="@drawable/bg_gray_rounded" android:layout_margin="8dp"/>
        <TextView android:id="@+id/assento3" android:layout_width="60dp" android:layout_height="60dp"
            android:text="3" android:gravity="center" android:background="@drawable/bg_gray_rounded" android:layout_margin="8dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/assento4" android:layout_width="60dp" android:layout_height="60dp"
            android:text="4" android:gravity="center" android:background="@drawable/bg_gray_rounded" android:layout_margin="8dp"/>
        <TextView android:id="@+id/assento5" android:layout_width="60dp" android:layout_height="60dp"
            android:text="5\nOCUPADO" android:textSize="10sp" android:gravity="center" android:background="#FFE0E0" android:layout_margin="8dp"/>
        <TextView android:id="@+id/assento6" android:layout_width="60dp" android:layout_height="60dp"
            android:text="6" android:gravity="center" android:background="@drawable/bg_gray_rounded" android:layout_margin="8dp"/>
    </LinearLayout>

    <TextView android:id="@+id/btnConfirmarAssento"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:text="Confirmar Assento" android:gravity="center"
        android:background="@drawable/bg_red_rounded" android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>
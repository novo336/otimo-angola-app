
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1116"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnVoltarMotorista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textColor="#CDFF35"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Torne-se motorista ÓTIMO"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sem mensalidade • Comissão de apenas 10%"
            android:textColor="#CDFF35"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DADOS PESSOAIS"
            android:textColor="#CDFF35"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/editNomeMotorista"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded"
            android:hint="Nome completo"
            android:padding="12dp"
            android:textColor="#000000"
            android:hintTextColor="#777777"
            android:inputType="textCapWords"
            android:enabled="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/editTelefoneMotorista"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded"
            android:hint="Número de telefone"
            android:padding="12dp"
            android:textColor="#000000"
            android:hintTextColor="#777777"
            android:inputType="phone"
            android:enabled="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/editNumeroBI"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded"
            android:hint="Número do Bilhete de Identidade"
            android:padding="12dp"
            android:textColor="#000000"
            android:hintTextColor="#777777"
            android:inputType="textCapCharacters"
            android:enabled="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DADOS DA VIATURA"
            android:textColor="#CDFF35"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/editMatricula"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded"
            android:hint="Matrícula da viatura"
            android:padding="12dp"
            android:textColor="#000000"
            android:hintTextColor="#777777"
            android:inputType="textCapCharacters"
            android:enabled="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/editTipoViatura"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded"
            android:hint="Tipo: Carrinha 2T, Camião 5T ou Outro"
            android:padding="12dp"
            android:textColor="#000000"
            android:hintTextColor="#777777"
            android:inputType="textCapWords"
            android:enabled="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:background="@drawable/bg_gray_rounded"
            android:text="VERIFICAÇÃO KYC&#10;&#10;Será necessário apresentar o BI e fotografias da viatura. Os documentos serão utilizados para verificar a identidade do motorista e não devem ficar públicos."
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/btnEnviarKyc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_red_rounded"
            android:gravity="center"
            android:text="ENVIAR PARA VERIFICAÇÃO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>

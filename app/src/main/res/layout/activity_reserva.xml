<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView android:id="@+id/btnVoltar1"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="← Voltar" android:textSize="16sp" android:padding="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Confirmar Reserva" android:textSize="22sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="24dp"
        android:background="@drawable/bg_gray_rounded" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Luanda → Benguela" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Hoje, 08:00 • 2 lugares" android:textColor="#757575"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Total: 15.000 Kz" android:textSize="20sp" android:textStyle="bold" android:textColor="#D41919"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <TextView android:id="@+id/btnConfirmar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@drawable/bg_red_rounded"
        android:text="CONFIRMAR E PAGAR" android:textColor="#FFFFFF"
        android:textStyle="bold" android:gravity="center"/>
</LinearLayout>
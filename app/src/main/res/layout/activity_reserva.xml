<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView android:id="@+id/btnVoltarConfirmar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="← Voltar" android:textSize="16sp" android:padding="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Confirmar Reserva"
        android:textSize="22sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="20dp"
        android:background="@drawable/bg_gray_rounded" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Detalhe da Viagem" android:textStyle="bold"/>

        <TextView android:id="@+id/txtDetalheViagem"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MACON - 08:00 | Assento 1 | 15.000 Kz"
            android:textSize="16sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Origem: Luanda - Gamek"
            android:textColor="#757575"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Destino: Benguela"
            android:textColor="#757575"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Data: Hoje"
            android:textColor="#757575"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Método de Pagamento: Multicaixa Express" android:textStyle="bold"/>

    <TextView android:id="@+id/btnPagar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="PAGAR AGORA" android:gravity="center"
        android:background="@drawable/bg_red_rounded" android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>
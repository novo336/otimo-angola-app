<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF" android:padding="20dp">
    <TextView android:id="@+id/btnVoltarConfirmar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Voltar" android:padding="8dp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Preço de referência" android:textSize="22sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_gray_rounded" android:padding="16dp" android:orientation="vertical">
        <TextView android:id="@+id/txtDetalheViagem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mudanças: Morro Bento → Kilamba" android:textStyle="bold"/>
        <TextView android:id="@+id/txtCalculo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Calculando..." android:lineSpacingExtra="6dp"/>
    </LinearLayout>
    <TextView android:id="@+id/btnPagar" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/bg_red_rounded" android:text="CONFIRMAR PEDIDO" android:gravity="center" android:textStyle="bold" android:textColor="#FFFFFF"/>
</LinearLayout>
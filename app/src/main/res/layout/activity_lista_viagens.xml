
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1116"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnVoltarLista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textColor="#CDFF35"
            android:textSize="16sp"
            android:padding="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="SOLICITAR TRANSPORTE"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtServicoEscolhido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Serviço: Mudanças"
            android:textColor="#CDFF35"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de telefone"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/editTelefoneCliente"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ex: 923000000"
            android:inputType="phone"
            android:enabled="true"
            android:focusable="true"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:background="@drawable/bg_white_rounded"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local de recolha (Origem)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/editOrigem"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ex: Nova Vida, Talatona"
            android:inputType="textCapSentences"
            android:enabled="true"
            android:focusable="true"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:background="@drawable/bg_white_rounded"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local de entrega (Destino)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/editDestino"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ex: Kilamba, Benfica, Viana"
            android:inputType="textCapSentences"
            android:enabled="true"
            android:focusable="true"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:background="@drawable/bg_white_rounded"/>

        <LinearLayout
            android:id="@+id/btnMapa"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gray_rounded"
            android:gravity="center">

            <TextView
                android:id="@+id/txtDestinoMapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ SELECIONAR DESTINO NO MAPA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distância (quilómetros)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/editDistancia"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ex: 5"
            android:inputType="numberDecimal"
            android:enabled="true"
            android:focusable="true"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:background="@drawable/bg_white_rounded"/>

        <TextView
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_red_rounded"
            android:text="CALCULAR PREÇO"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ÓTIMO ANGOLA • Transporte simples e seguro"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
